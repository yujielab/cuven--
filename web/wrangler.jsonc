// 前端站点（www.cuven.us）：纯静态资源，由 Workers Builds 从这个目录部署（根目录 /web，部署命令 npx wrangler deploy）。
// name 必须与 Cloudflare 控制台里这个 Worker 的名字一致，否则构建会失败。
// 待确认：控制台（网页翻译后）显示为「库文电视」，cuven-tv 是推测，拿到真实名字后改这一行。
{
  "name": "cuven-tv",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": ".",
    // 任何没有对应文件的路径都回 index.html（与现在线上的行为一致）；/index.html 照旧 307 到 /
    "not_found_handling": "single-page-application"
  }
}
