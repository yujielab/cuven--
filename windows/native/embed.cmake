# 把 shaders/*.hlsl 嵌进 DLL（运行时用 D3DCompile 编、按内容哈希缓存到磁盘）：生成 shaders_gen.h / shaders_gen.cpp
# cmake -DOUT=<目录> -DIN="a.hlsl;b.hlsl" -P embed.cmake
string(REPLACE "|" ";" IN "${IN}")
file(MAKE_DIRECTORY "${OUT}")
set(H "// 自动生成（embed.cmake），别改\n#pragma once\n#include <cstddef>\n")
set(C "// 自动生成（embed.cmake），别改\n#include \"shaders_gen.h\"\n")
foreach(F ${IN})
  get_filename_component(N "${F}" NAME_WE)
  file(READ "${F}" HEX HEX)
  string(LENGTH "${HEX}" L2)
  math(EXPR L "${L2} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
  string(APPEND H "extern const char* const k_${N}_hlsl;\nextern const std::size_t k_${N}_hlsl_len;\n")
  string(APPEND C "static const unsigned char k_${N}_raw[] = {${BYTES}0};\nconst char* const k_${N}_hlsl = reinterpret_cast<const char*>(k_${N}_raw);\nconst std::size_t k_${N}_hlsl_len = ${L};\n")
endforeach()
file(WRITE "${OUT}/shaders_gen.h.tmp" "${H}")
file(WRITE "${OUT}/shaders_gen.cpp.tmp" "${C}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}/shaders_gen.h.tmp" "${OUT}/shaders_gen.h")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}/shaders_gen.cpp.tmp" "${OUT}/shaders_gen.cpp")
